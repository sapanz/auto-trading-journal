<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tag_big_loss" model="trading.journal.tag">
            <field name="name">Big Loss</field>
            <field name="color">1</field>
        </record>
        <record id="tag_big_win" model="trading.journal.tag">
            <field name="name">Big Win</field>
            <field name="color">10</field>
        </record>
        <record id="tag_scalp" model="trading.journal.tag">
            <field name="name">Quick Scalp (&lt;2min)</field>
            <field name="color">4</field>
        </record>
        <record id="tag_revenge" model="trading.journal.tag">
            <field name="name">Possible Revenge Trade</field>
            <field name="color">2</field>
        </record>

        <record id="ir_cron_weekly_insight" model="ir.cron">
            <field name="name">Trading Journal: Generate Weekly Insight</field>
            <field name="model_id" ref="model_trading_journal_insight"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_weekly_insight()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
