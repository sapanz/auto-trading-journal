# Shared secret the fetcher (fetcher/fetch_trades.py) sends as the X-Api-Key
# header when pushing trades. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JOURNAL_API_KEY=changeme-generate-a-long-random-string

# ROI % threshold (absolute value) at which a closed position gets flagged
# "Big Loss" / "Big Win" (win threshold is 2x this value). Optional.
JOURNAL_BIG_LOSS_PERCENT=2.0

# --- Storage: pick ONE of the following ---

# Option A (recommended for any hosted/persistent deployment, e.g. Render):
# a Postgres connection string (e.g. from a free Neon database). When set,
# this takes priority over JOURNAL_DB_PATH below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B (local dev only — do NOT use on hosts with an ephemeral
# filesystem, e.g. Render's free tier, where this file gets wiped on every
# restart/redeploy): where the SQLite database file lives.
JOURNAL_DB_PATH=./journal.db
