# Shared secret the fetcher (fetcher/fetch_trades.py) sends as the X-Api-Key
# header when pushing trades. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JOURNAL_API_KEY=changeme-generate-a-long-random-string

# ROI % threshold (absolute value) at which a closed position gets flagged
# "Big Loss" / "Big Win" (win threshold is 2x this value). Optional.
JOURNAL_BIG_LOSS_PERCENT=2.0

# Where the SQLite database file lives. Optional — defaults to
# website/journal.db.
JOURNAL_DB_PATH=./journal.db
